#!/usr/bin/env python3
"""Check Git-visible changes for an accompanying cognitive memory update.

An ignored local bank cannot be verified by Git. That case is reported as a skip,
not as proof of freshness. Git errors always fail, including before a skip.
"""
import argparse
from pathlib import Path, PurePosixPath
import subprocess
import sys


class GitError(Exception):
    pass


def git(*args, cwd=None):
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True)
    if result.returncode:
        raise GitError(result.stderr.decode(errors="replace").strip() or f"git {args[0]} failed")
    return result.stdout


def paths(root, *args):
    return {p.decode(errors="surrogateescape") for p in git(*args, cwd=root).split(b"\0") if p}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--staged", action="store_true", help="staged changes (default)")
    modes.add_argument("--worktree", action="store_true", help="staged, unstaged and untracked files")
    modes.add_argument("--head", action="store_true", help="HEAD against its first parent, including merges")
    modes.add_argument("--range", metavar="A..B", help="explicit Git revision range")
    parser.add_argument("--quiet", action="store_true")
    args = parser.parse_args()
    say = lambda text: None if args.quiet else print(text)
    try:
        root = Path(git("rev-parse", "--show-toplevel").decode().strip())
        diff = ("--name-only", "-z", "--no-renames", "--diff-filter=ACMRDT")
        if args.range is not None:
            if not args.range or args.range.startswith("-") or ".." not in args.range:
                raise GitError("--range requires a Git revision range such as A..B")
            changed = paths(root, "diff", *diff, args.range, "--")
        elif args.head:
            parents = git("rev-list", "--parents", "-n", "1", "HEAD", "--", cwd=root).decode().split()
            if len(parents) > 1:
                changed = paths(root, "diff", *diff, parents[1], parents[0], "--")
            else:
                changed = paths(root, "diff-tree", "--root", "--no-commit-id", "-r", *diff, "HEAD", "--")
        else:
            changed = paths(root, "diff", "--cached", *diff, "--")
            if args.worktree:
                changed |= paths(root, "diff", *diff, "--")
                changed |= paths(root, "ls-files", "--others", "--exclude-standard", "-z")
        tracked = paths(root, "ls-files", "-z", "--", ".memory-bank")
        if (root / ".memory-bank").is_dir() and not tracked:
            say(".memory-bank/ is local and untracked; Git cannot verify its freshness. Skipping (not a freshness guarantee).")
            return 0
        project = sorted(p for p in changed if not p.startswith(".memory-bank/"))
        if not project:
            say("No project files changed outside .memory-bank/. OK.")
            return 0
        cognitive = {p for p in changed if PurePosixPath(p).parent == PurePosixPath(".memory-bank") and p.endswith(".md")}
        if cognitive:
            say(f"OK: {len(project)} project file(s) changed with a cognitive memory update.")
            return 0
        say("MEMORY BANK NOT UPDATED\nProject changes without an accompanying .memory-bank/*.md update:\n" + "\n".join("  " + repr(p) for p in project) + "\nUpdate activeContext and progress for the profile, then retry.")
        return 1
    except (GitError, OSError) as exc:
        if not args.quiet:
            print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
