#!/usr/bin/env bash
set -euo pipefail

DEFAULT_AGENT_RULES_ROOT="$HOME/projects/mb-agent-rules"
AGENT_RULES_ROOT="${AGENT_RULES_ROOT:-$DEFAULT_AGENT_RULES_ROOT}"
FORCE=0
DRY_RUN=0
ALLOW_OVERWRITE=0
PROJECT_TYPE=""
CLAUDE_MODE="import"
SKILLS_DIR=".agents/skills"
INSTALL_SKILL=1

usage() {
  cat <<'USAGE'
Usage:
  init-agent-rules <project-type> [options]

Project types:
  pentest
  academic-research
  general-project

Aliases:
  pentest: hardware-pentest, software-pentest
  academic-research: academic, research
  general-project: general, project

Run this command from the root of the target project. It initializes:
  memory-bank/                    from the selected project type template
  AGENTS.md                       universal agent instructions
  CLAUDE.md                       pointer to AGENTS.md (for Claude Code)
  .agents/skills/memory-bank/     portable Agent Skill for memory bank work

Options:
  --claude-mode=MODE  how CLAUDE.md is written (default: import)
                        import  one-line '@AGENTS.md' import; Claude Code
                                expands it, other tools load almost nothing
                        symlink CLAUDE.md -> AGENTS.md symlink
                        copy    full duplicate of AGENTS.md (legacy; causes
                                double-loading in tools that read both files)
  --skills-dir=PATH   where to install the Agent Skill (default: .agents/skills)
  --no-skill          do not install the Agent Skill
  --dry-run           preview without writing
  --force             overwrite all profile-managed files in place, with no
                      backup and no migration prompt (power-user escape hatch)

Existing installs are detected:
  - Nothing exists yet            -> fresh scaffolding is created.
  - Memory bank matches profile   -> nothing is changed.
  - Same file schema, stale rules -> AGENTS.md / CLAUDE.md / the skill are
                                     refreshed; memory-bank/ is left untouched.
  - File schema does NOT match    -> the old memory bank is backed up to
    (e.g. profile changed, or a      .old/memory-bank-<timestamp>/, fresh
     newer profile added files)      scaffolding is created, and you are
                                     told to ask your agent to migrate the
                                     old data into the new files.

Set AGENT_RULES_ROOT to override the source location:
  AGENT_RULES_ROOT=/path/to/mb-agent-rules init-agent-rules general-project
USAGE
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

log() {
  printf '%s\n' "$*"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --force)
      FORCE=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --claude-mode=*)
      CLAUDE_MODE="${1#*=}"
      case "$CLAUDE_MODE" in
        import|symlink|copy) ;;
        *) die "invalid --claude-mode: $CLAUDE_MODE (expected import, symlink, or copy)" ;;
      esac
      shift
      ;;
    --skills-dir=*)
      SKILLS_DIR="${1#*=}"
      [ -n "$SKILLS_DIR" ] || die "--skills-dir requires a path"
      shift
      ;;
    --no-skill)
      INSTALL_SKILL=0
      shift
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      if [ -n "$PROJECT_TYPE" ]; then
        die "expected one project type, got extra argument: $1"
      fi
      PROJECT_TYPE="$1"
      shift
      ;;
  esac
done

if [ -z "$PROJECT_TYPE" ]; then
  usage >&2
  exit 2
fi

case "$PROJECT_TYPE" in
  pentest|hardware-pentest|software-pentest)
    PROFILE="pentest"
    TEMPLATE_DIR_NAME="pentest-memory-bank"
    ;;
  academic-research|academic|research)
    PROFILE="academic-research"
    TEMPLATE_DIR_NAME="academic-research-memory-bank"
    ;;
  general-project|general|project)
    PROFILE="general-project"
    TEMPLATE_DIR_NAME="general-project-memory-bank"
    ;;
  *)
    die "unknown project type: $PROJECT_TYPE"
    ;;
esac

TARGET_ROOT="$(pwd -P)"
TEMPLATE_DIR="$AGENT_RULES_ROOT/templates/$TEMPLATE_DIR_NAME"
INSTRUCTIONS_SRC="$AGENT_RULES_ROOT/instructions/AGENTS.${PROFILE}.md"
SKILL_SRC="$AGENT_RULES_ROOT/skills/memory-bank/SKILL.md"
SKILL_DEST="$TARGET_ROOT/$SKILLS_DIR/memory-bank/SKILL.md"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"

for required in "$TEMPLATE_DIR" "$INSTRUCTIONS_SRC"; do
  [ -e "$required" ] || die "required source not found: $required"
done

if [ "$INSTALL_SKILL" -eq 1 ] && [ ! -f "$SKILL_SRC" ]; then
  die "required source not found: $SKILL_SRC (use --no-skill to skip)"
fi

# Required memory-bank file names for this profile (the canonical schema).
REQUIRED_FILES=()
while IFS= read -r f; do
  REQUIRED_FILES+=("$(basename "$f")")
done < <(find "$TEMPLATE_DIR" -maxdepth 1 -name '*.md' -type f | sort)

run_mkdir() {
  if [ "$DRY_RUN" -eq 1 ]; then
    log "mkdir -p ${1#$TARGET_ROOT/}"
  else
    mkdir -p "$1"
  fi
}

# Emit the CLAUDE.md content for the current mode. Claude Code reads CLAUDE.md
# and never AGENTS.md, so by default we point at AGENTS.md instead of copying it:
# tools that read both files then load the instructions only once.
expected_claude() {
  if [ "$CLAUDE_MODE" = "copy" ]; then
    printf '<!-- This file is identical to AGENTS.md. Edit AGENTS.md and re-run init-agent-rules to update both. -->\n\n'
    cat "$INSTRUCTIONS_SRC"
  else
    printf '<!-- Claude Code reads CLAUDE.md, not AGENTS.md. The line below imports it so both read the same instructions. Edit AGENTS.md instead of this file. -->\n\n'
    printf '@AGENTS.md\n'
  fi
}

copy_file() {
  local src="$1"
  local dest="$2"
  local existed=0

  run_mkdir "$(dirname "$dest")"

  [ -e "$dest" ] && existed=1

  if [ "$existed" -eq 1 ] && [ "$FORCE" -ne 1 ] && [ "$ALLOW_OVERWRITE" -ne 1 ]; then
    log "skip existing: ${dest#$TARGET_ROOT/}"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    if [ "$existed" -eq 1 ]; then
      log "overwrite: ${dest#$TARGET_ROOT/} <- ${src#$AGENT_RULES_ROOT/}"
    else
      log "copy: ${dest#$TARGET_ROOT/} <- ${src#$AGENT_RULES_ROOT/}"
    fi
  else
    cp "$src" "$dest"
    if [ "$existed" -eq 1 ]; then
      log "wrote: ${dest#$TARGET_ROOT/}"
    else
      log "created: ${dest#$TARGET_ROOT/}"
    fi
  fi
}

copy_template_dir() {
  local template_dir="$1"
  local dest_dir="$2"
  local src rel

  run_mkdir "$dest_dir"

  while IFS= read -r -d '' src; do
    rel="${src#$template_dir/}"
    copy_file "$src" "$dest_dir/$rel"
  done < <(find "$template_dir" -type f -print0 | sort -z)
}

install_claude() {
  local dest="$1"
  local existed=0

  run_mkdir "$(dirname "$dest")"

  { [ -e "$dest" ] || [ -L "$dest" ]; } && existed=1

  if [ "$existed" -eq 1 ] && [ "$FORCE" -ne 1 ] && [ "$ALLOW_OVERWRITE" -ne 1 ]; then
    log "skip existing: ${dest#$TARGET_ROOT/}"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "write: ${dest#$TARGET_ROOT/} ($CLAUDE_MODE of AGENTS.md)"
    return 0
  fi

  rm -f "$dest"
  if [ "$CLAUDE_MODE" = "symlink" ]; then
    ln -s "AGENTS.md" "$dest"
  else
    expected_claude > "$dest"
  fi

  if [ "$existed" -eq 1 ]; then
    log "wrote: ${dest#$TARGET_ROOT/} ($CLAUDE_MODE)"
  else
    log "created: ${dest#$TARGET_ROOT/} ($CLAUDE_MODE)"
  fi
}

install_skill() {
  [ "$INSTALL_SKILL" -eq 1 ] || return 0
  copy_file "$SKILL_SRC" "$SKILL_DEST"
}

# Move an existing path into the backup directory, preserving its basename.
backup_one() {
  local src="$1"
  local dest_dir="$2"

  { [ -e "$src" ] || [ -L "$src" ]; } || return 0

  if [ "$DRY_RUN" -eq 1 ]; then
    log "back up: ${src#$TARGET_ROOT/} -> ${dest_dir#$TARGET_ROOT/}/"
  else
    mkdir -p "$dest_dir"
    mv "$src" "$dest_dir/"
    log "backed up: ${src#$TARGET_ROOT/} -> ${dest_dir#$TARGET_ROOT/}/"
  fi
}

# --- Detection helpers -----------------------------------------------------

memory_bank_exists() {
  [ -d "$TARGET_ROOT/memory-bank" ] || return 1
  find "$TARGET_ROOT/memory-bank" -maxdepth 1 -name '*.md' -type f -print -quit \
    2>/dev/null | grep -q .
}

# Every required file for this profile is present (extra files are ignored).
structure_matches() {
  local f
  for f in "${REQUIRED_FILES[@]}"; do
    [ -f "$TARGET_ROOT/memory-bank/$f" ] || return 1
  done
  return 0
}

# Installed AGENTS.md, CLAUDE.md, and the skill are exactly what we would write.
rules_match() {
  [ -f "$TARGET_ROOT/AGENTS.md" ] || return 1
  diff -q "$TARGET_ROOT/AGENTS.md" "$INSTRUCTIONS_SRC" >/dev/null 2>&1 || return 1

  if [ "$CLAUDE_MODE" = "symlink" ]; then
    [ -L "$TARGET_ROOT/CLAUDE.md" ] || return 1
    [ "$(readlink "$TARGET_ROOT/CLAUDE.md")" = "AGENTS.md" ] || return 1
  else
    [ -f "$TARGET_ROOT/CLAUDE.md" ] || return 1
    [ -L "$TARGET_ROOT/CLAUDE.md" ] && return 1
    diff -q "$TARGET_ROOT/CLAUDE.md" <(expected_claude) >/dev/null 2>&1 || return 1
  fi

  if [ "$INSTALL_SKILL" -eq 1 ]; then
    [ -f "$SKILL_DEST" ] || return 1
    diff -q "$SKILL_DEST" "$SKILL_SRC" >/dev/null 2>&1 || return 1
  fi

  return 0
}

# --- Scaffolding -----------------------------------------------------------

scaffold_all() {
  copy_template_dir "$TEMPLATE_DIR" "$TARGET_ROOT/memory-bank"
  copy_file "$INSTRUCTIONS_SRC" "$TARGET_ROOT/AGENTS.md"
  install_claude "$TARGET_ROOT/CLAUDE.md"
  install_skill
}

print_migration_notice() {
  local backup_dir="$1"
  local rel="${backup_dir#$TARGET_ROOT/}"
  log ""
  log "========================================================================"
  log "ACTION REQUIRED: migrate your old memory bank"
  log "------------------------------------------------------------------------"
  log "A memory bank existed but did not match the '$PROFILE' profile schema."
  log "Your previous memory bank has been backed up to:"
  log ""
  log "    $rel/"
  log ""
  log "Fresh scaffolding was created in memory-bank/. The old content was NOT"
  log "migrated automatically (a bash script cannot do this reliably)."
  log ""
  log "Ask your AI agent to do it, for example:"
  log ""
  log "    \"Migrate my memory bank from $rel/ into the new memory-bank/"
  log "     scaffolding for the $PROFILE profile. Map old content to the new"
  log "     files, preserve history, and mark anything superseded.\""
  log "========================================================================"
}

# Claude Code loads skills only from .claude/skills/ (plus ~/.claude/skills and
# plugins), so a skill in .agents/skills/ is silently invisible to it.
claude_code_present() {
  [ -d "$TARGET_ROOT/.claude" ] && return 0
  [ -d "$HOME/.claude" ] && return 0
  [ -n "${CLAUDECODE:-}" ] && return 0
  command -v claude >/dev/null 2>&1 && return 0
  return 1
}

print_skill_advisory() {
  [ "$INSTALL_SKILL" -eq 1 ] || return 0

  log ""
  log "Agent Skill installed to $SKILLS_DIR/memory-bank/"

  case "$SKILLS_DIR" in
    .claude/skills|.claude/skills/)
      log "  Claude Code reads this location directly."
      return 0
      ;;
  esac

  log "  Read directly by VS Code / GitHub Copilot, which scans .agents/skills/."

  if claude_code_present; then
    log ""
    log "  Claude Code detected. It only scans .claude/skills/, so link it there:"
    log ""
    log "      mkdir -p .claude/skills && \\"
    log "        ln -s ../../$SKILLS_DIR/memory-bank .claude/skills/memory-bank"
    log ""
    log "  Restart Claude Code afterward if a session is already open."
  else
    log "  For tools that scan elsewhere, symlink or re-run with --skills-dir=PATH."
  fi
}

# --- Main ------------------------------------------------------------------

log "Initializing agent rules in: $TARGET_ROOT"
log "Project type: $PROFILE"
log ""

if [ "$FORCE" -eq 1 ]; then
  log "--force: overwriting profile-managed files in place (no backup, no migration prompt)."
  log ""
  scaffold_all
  log ""
  log "Done. AGENTS.md and CLAUDE.md are installed with the memory-bank/ schema."
  print_skill_advisory
  exit 0
fi

if ! memory_bank_exists; then
  # Fresh install.
  scaffold_all
  log ""
  log "Done. AGENTS.md and CLAUDE.md are installed with the memory-bank/ schema."
  log "AGENTS.md is read by Codex, Cursor, GitHub Copilot, and other AGENTS.md-aware agents."
  log "CLAUDE.md is read by Claude Code; it points at AGENTS.md ($CLAUDE_MODE mode)."
  print_skill_advisory
  exit 0
fi

# A memory bank already exists. Decide what to do.
if structure_matches; then
  if rules_match; then
    log "Existing memory bank already matches the '$PROFILE' profile."
    log "Nothing to do. (Use --force to rewrite profile-managed files in place.)"
    exit 0
  fi

  # Same file schema, but the instruction files are stale. Refresh only the
  # rules; leave the user's memory-bank/ content untouched.
  log "Memory bank schema matches '$PROFILE', but the installed rules are out of date."
  log "Refreshing instructions only; memory-bank/ is left untouched."
  log ""
  ALLOW_OVERWRITE=1
  copy_file "$INSTRUCTIONS_SRC" "$TARGET_ROOT/AGENTS.md"
  install_claude "$TARGET_ROOT/CLAUDE.md"
  install_skill
  ALLOW_OVERWRITE=0
  log ""
  log "Done. Instructions refreshed; no memory data was changed."
  print_skill_advisory
  exit 0
fi

# Structure mismatch: profile switched or schema changed. Back up and re-scaffold.
BACKUP_DIR="$TARGET_ROOT/.old/memory-bank-$TIMESTAMP"
log "Existing memory bank does NOT match the '$PROFILE' profile schema."
log "Backing up the old memory bank and creating fresh scaffolding."
log ""
backup_one "$TARGET_ROOT/memory-bank" "$BACKUP_DIR"
backup_one "$TARGET_ROOT/AGENTS.md" "$BACKUP_DIR"
backup_one "$TARGET_ROOT/CLAUDE.md" "$BACKUP_DIR"
log ""
ALLOW_OVERWRITE=1
scaffold_all
ALLOW_OVERWRITE=0
print_migration_notice "$BACKUP_DIR"
print_skill_advisory
