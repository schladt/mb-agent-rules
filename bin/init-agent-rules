#!/usr/bin/env python3
"""Install native AGENTS instructions and a project-local, hidden workspace."""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys
import tempfile

PROFILES = ("pentest", "academic-research", "general-project", "incident-response")
ALIASES = {"hardware-pentest": "pentest", "software-pentest": "pentest",
           "academic": "academic-research", "research": "academic-research",
           "general": "general-project", "project": "general-project",
           "incident": "incident-response", "dfir": "incident-response", "ir": "incident-response"}
BANK = ".memory-bank"
SHARED_SKILLS = ("memory-bank-context", "memory-bank-maintenance", "memory-bank-workflow")
LEGACY_SKILLS = ("memory-bank", "memory-bank-read-only", "evidence-review")
WORK_DIRS = ("planning/archive", "incoming", "references/datasets", "references/raw",
             "sensitive", "artifacts", "backups", "runtime")
LEGACY_STORES = {"sensitive": "sensitive", "incoming": "incoming", "artifacts": "artifacts",
                 "loot": "artifacts", "evidence": "artifacts", "ref-docs": "references",
                 "references": "references"}
IGNORE_BEGIN = "# BEGIN mb-agent-rules managed paths"
IGNORE_END = "# END mb-agent-rules managed paths"
CLAUDE_MARKER = "<!-- Claude Code reads CLAUDE.md, not AGENTS.md. The line below imports it so both read the same instructions. Edit AGENTS.md instead of this file. -->"
COPY_MARKER = "<!-- This file is identical to AGENTS.md. Edit AGENTS.md and re-run init-agent-rules to update both. -->"


class InstallError(Exception):
    pass


def digest(path):
    h = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def regular_tree(path):
    """Inventory metadata only; never follow a user store's symlinks."""
    if path.is_symlink():
        raise InstallError(f"Cannot migrate symlink store: {path}")
    if not path.is_dir():
        raise InstallError(f"Expected directory: {path}")
    for base, dirs, files in os.walk(path, followlinks=False):
        for name in dirs + files:
            p = Path(base) / name
            if p.is_symlink() or (not p.is_dir() and not p.is_file()):
                raise InstallError(f"Resolve non-regular migration entry first: {p}")
            yield p


def safe_destination(root, path):
    if not path.is_relative_to(root):
        raise InstallError(f"Destination escapes project: {path}")
    for p in (path, *path.parents):
        if p == root.parent:
            break
        if p.is_symlink():
            raise InstallError(f"Destination must not traverse a symlink: {p}")


def ensure_directory(path, mode=0o700):
    missing = []
    cursor = path
    while not cursor.exists():
        missing.append(cursor)
        cursor = cursor.parent
    for directory in reversed(missing):
        directory.mkdir(mode=mode)


def atomic_write(path, content, mode=0o644):
    ensure_directory(path.parent, 0o700 if mode == 0o600 else 0o755)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as out:
            out.write(content)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def managed_claude(path):
    if path.is_symlink():
        return os.readlink(path) == "AGENTS.md"
    if not path.is_file():
        return False
    text = path.read_text(encoding="utf-8")
    return text == CLAUDE_MARKER + "\n\n@AGENTS.md\n" or text.startswith(COPY_MARKER + "\n\n# ")


def ignore_content(old, migrating, legacy_install):
    lines = old.splitlines()
    result = []
    inside = False
    # Only exact exclusions generated by the legacy profile installer. A store's
    # old name alone does not prove that a user's broader ignore rule was managed.
    legacy = {"/memory-bank/", "/AGENTS.md", "/CLAUDE.md", "/.agents/", "/.claude/", "/.old/", "/sensitive/"}
    for line in lines:
        if line == IGNORE_BEGIN:
            if inside:
                raise InstallError("Malformed managed .gitignore block")
            inside = True
            continue
        if line == IGNORE_END:
            if not inside:
                raise InstallError("Malformed managed .gitignore block")
            inside = False
            continue
        if inside or line == f"/{BANK}/":
            continue
        if migrating and legacy_install and line in legacy:
            continue
        result.append(line)
    if inside:
        raise InstallError("Unclosed managed .gitignore block")
    prefix = "\n".join(result).rstrip()
    return (prefix + "\n\n" if prefix else "") + f"{IGNORE_BEGIN}\n/{BANK}/\n{IGNORE_END}\n"


class Installer:
    def __init__(self, args):
        self.args = args
        self.root = Path.cwd().resolve()
        self.source = Path(os.environ.get("AGENT_RULES_ROOT", Path(__file__).resolve().parent.parent)).resolve()
        self.profile = ALIASES.get(args.profile, args.profile)
        if self.profile not in PROFILES:
            raise InstallError(f"Unknown profile: {args.profile}")
        self.bank = self.root / BANK
        self.oldbank = self.root / "memory-bank"
        self.stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
        self.backup = self.bank / "backups" / self.stamp
        self.changed = False
        self.record = {}
        record = self.bank / "layout.json"
        safe_destination(self.root, record)
        if record.exists():
            self.record = json.loads(record.read_text(encoding="utf-8"))
            if not isinstance(self.record, dict) or self.record.get("schema") != 1:
                raise InstallError("Unsupported .memory-bank/layout.json; resolve before installation")
            previous = self.record.get("skills_dir", ".agents/skills")
            if not isinstance(previous, str) or Path(previous).is_absolute() or ".." in Path(previous).parts or Path(previous) == Path("."):
                raise InstallError("Unsafe recorded skill destination; resolve layout metadata before installation")
        skills_dir = args.skills_dir or ".agents/skills"
        skill_path = Path(skills_dir)
        if skill_path.is_absolute() or ".." in skill_path.parts or skill_path == Path("."):
            raise InstallError("--skills-dir must be a project-relative directory without '..'")
        self.skills_dir = skill_path.as_posix()
        self.skills = list(SHARED_SKILLS)
        same_profile = self.record.get("profile") == self.profile
        self.findings = args.findings or self.profile in ("pentest", "incident-response") or (same_profile and self.record.get("findings", False))
        self.external = args.external_status or self.profile in ("pentest", "incident-response") or (same_profile and self.record.get("external_status", False))
        if self.profile == "academic-research" and self.findings:
            raise InstallError("--findings is a general-project opt-in; academic-research uses research-specific records")
        if self.findings:
            self.skills.append("memory-bank-findings")
        if self.profile == "incident-response":
            self.skills.append("memory-bank-ir-evidence-review")
        self.template = self.source / "templates" / f"{self.profile}-memory-bank"
        self.instructions = self.source / "instructions" / f"AGENTS.{self.profile}.md"
        self.moves = []
        self.mappings = {}
        self.migration_entries = []
        self.legacy_install = False
        agents = self.root / "AGENTS.md"
        if agents.is_file() and not agents.is_symlink():
            self.legacy_install = bool(re.match(r"# (?:General Project|Pentest|Academic Research|Incident Response).*Memory Bank", agents.read_text(encoding="utf-8")))
        self.claude = self.root / "CLAUDE.md"

    def say(self, message):
        print(("[dry-run] " if self.args.dry_run else "") + message)

    def write(self, path, content, *, mode=0o644, backup=False):
        safe_destination(self.root, path)
        data = content.encode() if isinstance(content, str) else content
        if path.is_dir():
            raise InstallError(f"File destination is a directory: {path}")
        if path.is_file() and path.read_bytes() == data:
            return
        self.changed = True
        self.say(f"write {path.relative_to(self.root)}")
        if not self.args.dry_run:
            if backup and path.exists():
                dest = self.backup / "replaced" / path.relative_to(self.root)
                ensure_directory(dest.parent)
                shutil.copy2(path, dest)
                dest.chmod(0o600)
            atomic_write(path, data, mode)

    def mkdir(self, path, mode=0o700):
        safe_destination(self.root, path)
        if path.exists():
            if not path.is_dir():
                raise InstallError(f"Directory destination is a file: {path}")
            return
        self.changed = True
        self.say(f"mkdir {path.relative_to(self.root)}")
        if not self.args.dry_run:
            ensure_directory(path, mode)

    def preflight(self):
        if not self.template.is_dir() or not self.instructions.is_file():
            raise InstallError(f"Missing profile sources under {self.source}")
        safe_destination(self.root, self.bank)
        safe_destination(self.root, self.root / self.skills_dir)
        if self.oldbank.exists():
            if not self.args.migrate:
                raise InstallError("Legacy memory-bank/ exists. Preview with --migrate --dry-run, then use --migrate.")
            if self.bank.exists():
                raise InstallError("Both memory-bank/ and .memory-bank/ exist; reconcile their contents before migration.")
            list(regular_tree(self.oldbank))
            self.moves.append((self.oldbank, self.bank))
            self.mappings["memory-bank/"] = f"{BANK}/"
        if self.args.migrate:
            for old, new in LEGACY_STORES.items():
                src = self.root / old
                if src.exists() or src.is_symlink():
                    list(regular_tree(src))
                    self.moves.append((src, self.bank / new))
                    self.mappings[old + "/"] = f"{BANK}/{new}/"
            for old, new in ((".old", "backups/legacy"), ("dashboard/certs", "runtime/dashboard/certs"),
                             ("dashboard/venv", "runtime/dashboard/venv"), ("dashboard/cache", "runtime/dashboard/cache")):
                src = self.root / old
                if src.exists():
                    # Venv trees contain interpreter symlinks; move them intact, not through a data reader.
                    if src.is_symlink():
                        raise InstallError(f"Resolve symlink before migration: {src}")
                    self.moves.append((src, self.bank / new))
            config = self.root / "dashboard.config.json"
            if config.exists():
                self.moves.append((config, self.bank / "dashboard.config.json"))
        destinations = {}
        for src, dest in self.moves:
            safe_destination(self.root, dest)
            entries = [src] + (list(src.rglob("*")) if src.is_dir() else [])
            for entry in entries:
                final = dest / entry.relative_to(src)
                directory = entry.is_dir() and not entry.is_symlink()
                if final in destinations and not (directory and destinations[final]):
                    raise InstallError(f"Migration collision at {final.relative_to(self.root)}; no files moved. Choose a disposition first.")
                candidates = [final]
                if src != self.oldbank and self.oldbank.exists():
                    candidates.append(self.oldbank / final.relative_to(self.bank))
                for candidate in candidates:
                    if candidate.exists() or candidate.is_symlink():
                        if not (directory and candidate.is_dir() and not candidate.is_symlink()):
                            raise InstallError(f"Migration collision at {final.relative_to(self.root)}; no files moved. Choose a disposition first.")
                    for parent in candidate.parents:
                        if parent == self.root:
                            break
                        if parent.exists() and not parent.is_dir():
                            raise InstallError(f"Migration parent is not a directory: {parent}")
                destinations[final] = directory
                if not directory:
                    stat = entry.lstat()
                    record = {"source": entry.relative_to(self.root).as_posix(),
                              "destination": final.relative_to(self.root).as_posix(),
                              "source_store": src.relative_to(self.root).as_posix(),
                              "size": stat.st_size, "mtime_ns": stat.st_mtime_ns,
                              "mode": oct(stat.st_mode & 0o777)}
                    if entry.is_symlink():
                        record["symlink"] = os.readlink(entry)
                    else:
                        record["sha256"] = digest(entry)
                    self.migration_entries.append(record)
        for final in destinations:
            if any(parent in destinations and not destinations[parent] for parent in final.parents):
                raise InstallError(f"Migration file/directory collision at {final.relative_to(self.root)}; no files moved.")
        if self.moves and not (self.source / "skills/memory-bank-workflow/scripts/workspace.py").is_file():
            raise InstallError("Migration requires the complete memory-bank-workflow package")
        if not self.args.no_skill:
            # Discovery and retirement also touch these paths, even when they are
            # not the selected package destination. Check ancestors before reads
            # or any installation/migration writes.
            safe_destination(self.root, self.root / ".claude/skills")
            if self.args.migrate and self.legacy_install and self.oldbank.is_dir() and not self.record:
                self.record = self.legacy_skill_record()
            previous_dir = self.record.get("skills_dir")
            if previous_dir:
                safe_destination(self.root, self.root / previous_dir)
            for name in self.skills:
                src = self.source / "skills" / name
                if not (src / "SKILL.md").is_file():
                    raise InstallError(f"Missing complete skill package: {src}")
                for parent in {self.root / self.skills_dir, self.root / ".claude/skills"}:
                    self.validate_skill_link(name, parent / name)
            for name in self.record.get("skill_packages", []):
                if name in (*SHARED_SKILLS, "memory-bank-findings", "memory-bank-ir-evidence-review") and previous_dir:
                    self.validate_skill_link(name, self.root / previous_dir / name)
        if self.findings:
            flavor = "incident-response" if self.profile == "incident-response" else "pentest"
            self.finding_template = self.source / "templates/findings" / flavor
            if not (self.finding_template / "_TEMPLATE/finding.md").is_file():
                raise InstallError(f"Missing finding template: {self.finding_template}")
        if self.claude.exists() or self.claude.is_symlink():
            if not managed_claude(self.claude):
                self.say("WARNING: user-owned CLAUDE.md preserved; it can suppress Claude's native AGENTS fallback. Resolve its instruction source explicitly.")
        for relative in (".claude/CLAUDE.md", "CLAUDE.local.md"):
            if (self.root / relative).exists():
                self.say(f"WARNING: {relative} can suppress native AGENTS fallback; it is not modified.")
        # Validate generated destinations before the first mutation.
        for path in (self.root / "AGENTS.md", self.root / ".gitignore", self.bank / "layout.json", self.root / "deliverables/README.md"):
            safe_destination(self.root, path)
            if path.is_dir():
                raise InstallError(f"Expected file at {path}")
        old_ignore = (self.root / ".gitignore").read_text() if (self.root / ".gitignore").exists() else ""
        self.new_ignore = ignore_content(old_ignore, self.args.migrate, self.legacy_install)
        if self.moves:
            git = subprocess.run(["git", "ls-files", "-z"], cwd=self.root, capture_output=True)
            if git.returncode == 0:
                tracked = git.stdout.decode(errors="surrogateescape").split("\0")
                if any(any(p == str(src.relative_to(self.root)) or p.startswith(str(src.relative_to(self.root)) + "/") for src, _ in self.moves) for p in tracked if p):
                    self.say("WARNING: migrated inputs are tracked by Git. Moving/ignoring them does not remove historical copies; review index/history separately. No Git mutation will run.")

    def move_tree(self, src, dest):
        if not src.is_dir():
            ensure_directory(dest.parent)
            shutil.move(str(src), str(dest))
            return
        if not dest.exists():
            ensure_directory(dest.parent)
            shutil.move(str(src), str(dest))
            return
        for entry in src.iterdir():
            self.move_tree(entry, dest / entry.name)
        src.rmdir()

    def migrate(self):
        for src, dest in self.moves:
            self.changed = True
            self.say(f"move {src.relative_to(self.root)} -> {dest.relative_to(self.root)}")
            if not self.args.dry_run:
                self.move_tree(src, dest)
                if dest == self.bank:
                    self.bank.chmod(0o700)
        if self.moves and not self.args.dry_run:
            for record in self.migration_entries:
                path = self.root / record["destination"]
                if "sha256" in record and digest(path) != record["sha256"]:
                    raise InstallError(f"Migration hash verification failed at {record['destination']}; preserve all remaining stores for investigation.")
                if "symlink" in record and (not path.is_symlink() or os.readlink(path) != record["symlink"]):
                    raise InstallError(f"Migration link verification failed at {record['destination']}")
            self.write(self.backup / "migration.json", json.dumps({"schema": 1, "completed_at": self.stamp, "entries": self.migration_entries}, indent=2) + "\n", mode=0o600)
        if self.mappings:
            mapping_path = self.bank / "path-migrations.json"
            previous = json.loads(mapping_path.read_text()) if mapping_path.exists() else {"schema": 1, "prefixes": {}, "project_roots": []}
            previous["prefixes"].update(self.mappings)
            if str(self.root) not in previous["project_roots"]:
                previous["project_roots"].append(str(self.root))
            self.write(mapping_path, json.dumps(previous, indent=2) + "\n", mode=0o600)
            if not self.args.dry_run:
                ensure_directory(self.backup)
                # Cognitive records only; do not traverse acquired material as memory.
                for path in self.bank.glob("*.md"):
                    if path.is_file() and not path.is_symlink():
                        shutil.copy2(path, self.backup / path.name)
                        (self.backup / path.name).chmod(0o600)
            self.rewrite_current_references()

    def rewrite_current_references(self):
        if self.args.dry_run:
            self.say("repair current Markdown links and cognitive code-path references; preserve originals")
            return
        helpers = runpy.run_path(str(self.source / "skills/memory-bank-workflow/scripts/workspace.py"))
        paths = [self.bank / path.name for path in self.template.glob("*.md")]
        paths += [self.bank / "findings.md", self.bank / "references/reference.md", self.root / "README.md"]
        paths += helpers["active_plans"](self.root, self.bank / "planning")
        paths += list((self.root / "findings").rglob("*.md"))
        for path in dict.fromkeys(paths):
            if not path.is_file() or path.is_symlink():
                continue
            safe_destination(self.root, path)
            original = path.read_text()
            updated = original
            for old, new in self.mappings.items():
                updated = helpers["moved_references"](
                    updated, path, self.root, self.root / old, self.root / new,
                    directory=True, code_paths=path.is_relative_to(self.bank))
            if updated != original:
                self.write(path, updated, mode=0o600 if path.is_relative_to(self.bank) else 0o644, backup=True)

    def legacy_skill_record(self):
        """Recover the old installer's package location from its discovery links."""
        record = {}
        for name in ("memory-bank-context", "memory-bank-maintenance", "memory-bank-ir-evidence-review"):
            link = self.root / ".claude/skills" / name
            if not link.is_symlink():
                continue
            target = Path(os.readlink(link))
            # The legacy installer emitted ../../<skills-dir>/<name>, never an
            # absolute target. Do not infer ownership from the link name alone.
            if target.parts[:2] != ("..", "..") or len(target.parts) < 4:
                continue
            relative = Path(*target.parts[2:])
            if ".." in relative.parts or relative.name != name:
                continue
            package = self.root / relative
            safe_destination(self.root, package / "SKILL.md")
            if not package.is_dir() or not (package / "SKILL.md").is_file():
                continue
            header, separator, _ = (package / "SKILL.md").read_text(encoding="utf-8").partition("\n---\n")
            if not (header.startswith("---\n") and separator and
                    re.search(rf"(?m)^name: {re.escape(name)}\s*$", header)):
                continue
            if any(package.is_relative_to(src) for src, _ in self.moves):
                raise InstallError(f"Legacy skill package is inside a migrating store: {package}; relocate it before migration")
            previous_dir = relative.parent.as_posix()
            if record and record["skills_dir"] != previous_dir:
                raise InstallError("Legacy skill discovery links identify different package directories; reconcile before migration")
            record["skills_dir"] = previous_dir
            record.setdefault("skill_packages", []).append(name)
        return record

    def validate_skill_link(self, name, dest):
        if not dest.is_symlink():
            return
        resolved = dest.resolve()
        if resolved == (self.source / "skills" / name).resolve():
            return
        previous_dir = self.record.get("skills_dir")
        if previous_dir and name in self.record.get("skill_packages", []):
            previous = self.root / previous_dir / name
            # Metadata must identify a separate, real managed package. Resolving
            # dest against itself would bless any user-owned symlink.
            if previous != dest and previous.is_dir() and not previous.is_symlink():
                safe_destination(self.root, previous)
                if resolved == previous.resolve():
                    return
        raise InstallError(f"Skill destination is an unrelated symlink: {dest}")

    def install_skill(self, name):
        source = self.source / "skills" / name
        dest = self.root / self.skills_dir / name
        if dest.is_symlink():
            resolved = dest.resolve()
            if resolved == source.resolve():
                # A source checkout may intentionally link its own complete package.
                return
            self.validate_skill_link(name, dest)
            self.changed = True
            self.say(f"replace managed discovery link with complete package: {dest.relative_to(self.root)}")
            if self.args.dry_run:
                return
            dest.unlink()
        for path in sorted(source.rglob("*")):
            if not path.is_file() or "__pycache__" in path.parts or path.suffix == ".pyc":
                continue
            self.write(dest / path.relative_to(source), path.read_bytes(), mode=0o755 if os.access(path, os.X_OK) else 0o644, backup=True)

    def claude_links(self):
        if self.skills_dir == ".claude/skills":
            return
        safe_destination(self.root, self.root / ".claude/skills")
        present = (self.root / ".claude").exists() or (Path.home() / ".claude").is_dir() or os.environ.get("CLAUDECODE") or shutil.which("claude")
        if not present:
            return
        for name in self.skills:
            dest = self.root / ".claude/skills" / name
            target = os.path.relpath(self.root / self.skills_dir / name, dest.parent)
            if dest.is_symlink() and os.readlink(dest) == target:
                continue
            if dest.exists() and not dest.is_symlink():
                source = self.source / "skills" / name
                # Replace only a known package. Unknown extras are preserved with a conflict.
                existing = {str(p.relative_to(dest)): p for p in dest.rglob("*") if p.is_file()}
                expected = {str(p.relative_to(source)): p for p in source.rglob("*") if p.is_file() and "__pycache__" not in p.parts}
                known = existing and all(k in expected and digest(v) == digest(expected[k]) for k, v in existing.items())
                if not known and self.record.get("skills_dir") != ".claude/skills":
                    raise InstallError(f"Preserved user skill directory {dest}; move it explicitly before creating discovery link")
                self.say(f"back up existing skill directory {dest.relative_to(self.root)}")
                if not self.args.dry_run:
                    backup = self.backup / "skills" / name
                    ensure_directory(backup.parent)
                    shutil.move(str(dest), str(backup))
            self.changed = True
            self.say(f"link {dest.relative_to(self.root)} -> {target}")
            if not self.args.dry_run:
                dest.parent.mkdir(parents=True, exist_ok=True)
                if dest.is_symlink():
                    dest.unlink()
                dest.symlink_to(target, target_is_directory=True)

    def retire_previous_skills(self):
        previous_dir = self.record.get("skills_dir")
        if not previous_dir:
            return
        for name in self.record.get("skill_packages", []):
            if name not in (*SHARED_SKILLS, "memory-bank-findings", "memory-bank-ir-evidence-review"):
                continue
            if previous_dir == self.skills_dir and name in self.skills:
                continue
            # Current Claude discovery links have already been refreshed.
            if previous_dir == ".claude/skills" and name in self.skills:
                continue
            path = self.root / previous_dir / name
            safe_destination(self.root, path.parent)
            if path.resolve() == (self.source / "skills" / name).resolve():
                continue
            if path.is_symlink():
                self.say(f"retire old managed skill link {path.relative_to(self.root)}")
                self.changed = True
                if not self.args.dry_run:
                    path.unlink()
            elif path.exists():
                safe_destination(self.root, path)
                self.say(f"archive previous managed skill package {path.relative_to(self.root)}")
                self.changed = True
                if not self.args.dry_run:
                    backup = self.backup / "retired-skills" / previous_dir / name
                    ensure_directory(backup.parent)
                    shutil.move(str(path), str(backup))
            link = self.root / ".claude/skills" / name
            if name not in self.skills and link.is_symlink() and link.resolve() == path.resolve():
                self.changed = True
                if not self.args.dry_run:
                    link.unlink()

    def retire_legacy(self):
        if managed_claude(self.claude):
            self.changed = True
            self.say("archive obsolete managed CLAUDE.md instruction bridge")
            if not self.args.dry_run:
                ensure_directory(self.backup)
                shutil.move(str(self.claude), str(self.backup / "CLAUDE.md"))
        if self.args.no_skill:
            return
        for parent in {self.root / self.skills_dir, self.root / ".claude/skills"}:
            for name in LEGACY_SKILLS:
                path = parent / name
                if not path.exists() and not path.is_symlink():
                    continue
                if path.is_symlink():
                    if not path.resolve().is_relative_to(self.source / "skills"):
                        self.say(f"WARNING: preserving unrelated legacy-name link {path.relative_to(self.root)}")
                        continue
                elif not (path / "SKILL.md").is_file() or not re.search(r"(?m)^name: (?:memory-bank|memory-bank-read-only|evidence-review)\s*$", (path / "SKILL.md").read_text()):
                    self.say(f"WARNING: preserving unrecognized legacy-name directory {path.relative_to(self.root)}")
                    continue
                self.changed = True
                self.say(f"archive legacy managed skill {path.relative_to(self.root)}")
                if not self.args.dry_run:
                    dest = self.backup / "legacy-skills" / parent.relative_to(self.root) / name
                    ensure_directory(dest.parent)
                    if path.is_symlink():
                        path.unlink()
                    elif (path / "SKILL.md").is_file():
                        ensure_directory(dest)
                        shutil.move(str(path / "SKILL.md"), str(dest / "SKILL.md"))
                        if not any(path.iterdir()):
                            path.rmdir()

    def install(self):
        self.preflight()
        self.migrate()
        self.mkdir(self.bank)
        old_profile = self.record.get("profile")
        if old_profile and old_profile != self.profile:
            self.say(f"Profile change {old_profile} -> {self.profile}: preserve records; audit semantic mapping with memory-bank-maintenance")
        for sub in WORK_DIRS:
            self.mkdir(self.bank / sub)
        for path in sorted(self.template.rglob("*")):
            if not path.is_file():
                continue
            relative = path.relative_to(self.template)
            dest = self.bank / relative
            exists = dest.exists() or (self.args.dry_run and self.oldbank.exists() and (self.oldbank / relative).exists())
            if not exists or (self.args.force and relative.parent == Path(".")):
                self.write(dest, path.read_bytes(), mode=0o600, backup=True)
        if self.mappings and not self.args.dry_run:
            rows = "\n".join(f"- `{old}` → `{new}`" for old, new in self.mappings.items())
            note = f"\n## Storage migration — {self.stamp} — Done\n\nHistorical narrative and custody bytes are preserved. Current Markdown links and cognitive code-path targets were updated with originals retained in backups; path-migrations.json resolves immutable historical references. New records use canonical paths.\n\n{rows}\n"
            for name in ("progress.md", "activeContext.md", "sensitiveDataPolicy.md"):
                path = self.bank / name
                text = path.read_text()
                if name == "sensitiveDataPolicy.md":
                    for old, new in LEGACY_STORES.items():
                        text = text.replace(f"`{old}/`", f"`{BANK}/{new}/`")
                    note_policy = "\nCurrent profile-managed stores are direct children of .memory-bank/. Existing classification, authorization and privacy constraints remain in force; current store paths above supersede legacy declarations. Original cognitive records are retained in backups.\n"
                else:
                    note_policy = ""
                self.write(path, text + note + note_policy, mode=0o600)
        if old_profile and old_profile != self.profile and not self.args.dry_run:
            path = self.bank / "progress.md"
            self.write(path, path.read_text() + f"\n## Profile change — {self.stamp} — Planned\n\nChanged {old_profile} to {self.profile}; historical records retained. Review authority and map domain semantics before operational work.\n", mode=0o600)
        instructions = self.instructions.read_text().replace(".agents/skills", self.skills_dir)
        if self.findings and self.profile == "general-project":
            instructions += "\n## Enabled Optional Findings\n\nThis installation also loads `.memory-bank/findings.md` after authority files. It is the lightweight status authority; canonical full narratives live under `findings/`. Use `memory-bank-findings` for promotion, synchronization and warning-only preflight. This explicit opt-in does not change project authorization or automatically enable IR custody.\n"
        self.write(self.root / "AGENTS.md", instructions, backup=True)
        self.retire_legacy()
        if not self.args.no_skill:
            for name in self.skills:
                self.install_skill(name)
            self.claude_links()
            self.retire_previous_skills()
        deliverables = self.root / "deliverables/README.md"
        if not deliverables.exists():
            self.write(deliverables, "# Deliverables\n\nFinal reports, exports and archives live here once. This directory is eligible for Git tracking; generation does not authorize staging, committing or external delivery. Canonical report-facing source lives in findings/ where enabled. No document compiler is installed by this project.\n")
        if self.findings:
            log = self.bank / "findings.md"
            if self.profile == "general-project" and not log.exists():
                source = self.source / "templates/pentest-memory-bank/findings.md"
                self.write(log, source.read_bytes(), mode=0o600)
            for path in sorted(self.finding_template.rglob("*")):
                if path.is_file():
                    dest = self.root / "findings" / path.relative_to(self.finding_template)
                    if not dest.exists() or self.args.force:
                        self.write(dest, path.read_bytes(), backup=True)
        layout = {"schema": 1, "profile": self.profile, "skills_dir": self.skills_dir,
                  "findings": bool(self.findings), "external_status": bool(self.external),
                  "skill_packages": self.record.get("skill_packages", []) if self.args.no_skill else self.skills}
        self.write(self.bank / "layout.json", json.dumps(layout, indent=2) + "\n", mode=0o600)
        self.write(self.root / ".gitignore", self.new_ignore)
        if self.external:
            command = self.source / "skills/memory-bank-workflow/scripts/workspace.py"
            invocation = [sys.executable, "-B", str(command), "--root", str(self.root), "status"]
            if self.args.dry_run:
                self.say("check/generate team-status.md for teammates from approved publishable fields")
            else:
                checked = subprocess.run([*invocation, "--check"], capture_output=True, text=True)
                if checked.returncode:
                    self.changed = True
                    self.say("generate team-status.md for teammates from approved publishable fields")
                    if subprocess.run(invocation).returncode:
                        raise InstallError("Installation preserved; team status generation failed. Resolve the reported source or output conflict and rerun status.")
                elif checked.stderr:
                    sys.stderr.write(checked.stderr)
        self.say("Installation complete." if self.changed else "Nothing to do. Existing workspace matches.")
        if self.moves:
            self.say("Historical paths are recorded in .memory-bank/path-migrations.json; review reference links and the appended migration ledger. Acquired bytes and original cognitive snapshots were preserved.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("profile", help="pentest, incident-response, academic-research, general-project (aliases accepted)")
    parser.add_argument("--migrate", action="store_true", help="explicitly relocate legacy bank/data stores; conflicts are preflighted")
    parser.add_argument("--dry-run", action="store_true", help="show changes without writing")
    parser.add_argument("--force", action="store_true", help="replace cognitive templates/scaffolds after preserving originals in bank backups")
    parser.add_argument("--skills-dir", help="project-relative skill destination (default .agents/skills)")
    parser.add_argument("--no-skill", action="store_true", help="skip installing portable skill packages")
    parser.add_argument("--findings", action="store_true", help="enable optional security finding conventions")
    parser.add_argument("--external-status", action="store_true", help="enable team-status.md outside the memory bank for research/general profiles; not client-facing")
    args = parser.parse_args()
    try:
        Installer(args).install()
        return 0
    except (InstallError, OSError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
