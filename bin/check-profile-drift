#!/usr/bin/env python3
"""Compare explicit cognitive file references with each profile's templates."""
import os
from pathlib import Path
import re
import sys


def main():
    root = Path(os.environ.get("AGENT_RULES_ROOT", Path(__file__).resolve().parent.parent))
    if not root.is_dir():
        print(f"error: AGENT_RULES_ROOT not found: {root}", file=sys.stderr)
        return 2
    status = 0
    for profile in ("pentest", "academic-research", "general-project", "incident-response"):
        instructions = root / "instructions" / f"AGENTS.{profile}.md"
        templates = root / "templates" / f"{profile}-memory-bank"
        if not instructions.is_file() or not templates.is_dir():
            print(f"[{profile}] missing instructions or templates", file=sys.stderr)
            status = 1
            continue
        text = instructions.read_text(encoding="utf-8")
        referenced = set(re.findall(r"(?<![\w/])\.memory-bank/([A-Za-z][A-Za-z0-9_-]*\.md)", text))
        supplied = {p.name for p in templates.glob("*.md") if p.is_file()}
        if referenced == supplied and supplied:
            print(f"[{profile}] OK ({len(supplied)} cognitive files agreed)")
            continue
        status = 1
        print(f"[{profile}] DRIFT detected")
        for label, difference in (("in instructions but not templates", referenced - supplied), ("in templates but not instructions", supplied - referenced)):
            if difference:
                print(f"  {label}: {', '.join(sorted(difference))}")
        if not supplied:
            print("  empty cognitive template set")
    return status


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, UnicodeError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(2)
